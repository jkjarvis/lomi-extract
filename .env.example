# Copy to .env (never commit it). Everything defaults sensibly without it (mock LLM).
# Host ports, if the defaults are taken. Compose reads these from .env; then point tests at them (API_URL, WEB_URL,
# REDIS_URL, DATABASE_URL) and local dev at them (REDIS_URL, DATABASE_URL).
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# API_PORT=3001
# WEB_PORT=8080
# LLM_PROVIDER=anthropic        # anthropic | openai | mock
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# MOCK_LLM_DELAY_MS=0
# MOCK_LLM_FAIL=never           # never | always | once
# MOCK_LLM_HALLUCINATE=         # comma list of field names
# RECONCILE_INTERVAL_MS=10000
# LEASE_MS=30000
