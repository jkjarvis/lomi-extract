# Copy to .env (never commit it). Everything defaults sensibly without it (mock LLM).
# LLM_PROVIDER=anthropic        # anthropic | openai | mock
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# MOCK_LLM_DELAY_MS=0
# MOCK_LLM_FAIL=never           # never | always | once
# MOCK_LLM_HALLUCINATE=         # comma list of field names
# RECONCILE_INTERVAL_MS=10000
# LEASE_MS=30000
