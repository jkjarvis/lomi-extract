{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@lomi/db#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "coverage": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "KEEP_TEST_DB",
        "PROCESS_TEST_REDIS_URL"
      ]
    },
    "test:db": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "KEEP_TEST_DB"
      ]
    },
    "test:process": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "KEEP_TEST_DB",
        "PROCESS_TEST_REDIS_URL"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "CHAOS",
        "API_URL",
        "DATABASE_URL",
        "REDIS_URL",
        "HOME",
        "USER",
        "DOCKER_*",
        "COMPOSE_*",
        "MOCK_LLM_*",
        "LLM_PROVIDER",
        "RECONCILE_INTERVAL_MS",
        "LEASE_MS",
        "POSTGRES_PORT",
        "REDIS_PORT",
        "API_PORT",
        "WEB_PORT",
        "WEB_URL",
        "REPO_ROOT",
        "FIXTURES_DIR",
        "SKIP_WORKER_RESET"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
