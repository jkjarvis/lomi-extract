{
  "name": "@lomi/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure domain logic: normalisation, evidence validation, carry-over, progress. No I/O.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include=src/** --coverage.reporter=text --coverage.reporter=json-summary --coverage.reportsDirectory=coverage",
    "test:spec": "vitest run test/spec"
  },
  "devDependencies": {
    "@lomi/config": "workspace:*",
    "@types/node": "22.19.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
