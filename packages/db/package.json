{
  "name": "@lomi/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations, idempotent fixture seed, and the shared Prisma client.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "prisma"],
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node dist/seed.js"
  },
  "dependencies": {
    "@lomi/core": "workspace:*",
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@lomi/config": "workspace:*",
    "@types/node": "22.19.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
