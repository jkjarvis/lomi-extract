{
  "name": "@lomi/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations, idempotent fixture seed, and the shared Prisma client.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include=src/** --coverage.reporter=text --coverage.reporter=json-summary --coverage.reportsDirectory=coverage --coverage.exclude=src/testing.ts",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node dist/seed.js"
  },
  "dependencies": {
    "@lomi/core": "workspace:*",
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@lomi/config": "workspace:*",
    "@types/node": "22.19.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
